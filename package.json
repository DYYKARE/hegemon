{
  "name": "hegemon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "android": "$HOME/Library/Android/sdk/platform-tools/adb reverse tcp:3000 tcp:3000 && vite --port=3000 --host=0.0.0.0",
    "apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug && $HOME/Library/Android/sdk/platform-tools/adb install -r app/build/outputs/apk/debug/app-debug.apk",
    "aab": "vite build && cap sync android && cd android && ./gradlew bundleRelease && echo 'AAB: android/app/build/outputs/bundle/release/app-release.aab'",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/playtest.mjs",
    "test:guide": "node scripts/playtest.mjs --guide",
    "test:balance": "tsx scripts/balance-sim.ts all",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=masaustu",
    "test:all": "npm run lint && npm test && npm run test:guide && npm run test:e2e"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "topojson-client": "^3.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.61.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
