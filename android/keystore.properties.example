# Yayın imzası şablonu — kopyala: cp keystore.properties.example keystore.properties
# keystore.properties git'e GİRMEZ (.gitignore). Anahtar üretimi:
#   keytool -genkeypair -v -keystore hegemon-release.keystore \
#     -alias hegemon -keyalg RSA -keysize 2048 -validity 10000
# storeFile yolu bu dosyaya (android/app/ dizinine) GÖRELİDİR.
storeFile=../hegemon-release.keystore
storePassword=DEĞİŞTİR
keyAlias=hegemon
keyPassword=DEĞİŞTİR
